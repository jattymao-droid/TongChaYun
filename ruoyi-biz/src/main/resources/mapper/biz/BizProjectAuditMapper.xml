<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizProjectAuditMapper">

    <resultMap type="com.ruoyi.biz.domain.BizProjectAudit" id="AuditResult">
        <id property="auditId" column="audit_id"/>
        <result property="projectType" column="project_type"/>
        <result property="projectId" column="project_id"/>
        <result property="action" column="action"/>
        <result property="detail" column="detail"/>
        <result property="operName" column="oper_name"/>
        <result property="operTime" column="oper_time"/>
    </resultMap>

    <insert id="insert" parameterType="com.ruoyi.biz.domain.BizProjectAudit" useGeneratedKeys="true" keyProperty="auditId">
        insert into biz_project_audit (project_type, project_id, action, detail, oper_name, oper_time)
        values (#{projectType}, #{projectId}, #{action}, #{detail}, #{operName}, now())
    </insert>

    <select id="selectList" resultMap="AuditResult">
        select audit_id, project_type, project_id, action, detail, oper_name, oper_time
        from biz_project_audit
        <where>
            <if test="projectType != null and projectType != ''">and project_type = #{projectType}</if>
            <if test="projectId != null">and project_id = #{projectId}</if>
            <if test="action != null and action != ''">and action = #{action}</if>
        </where>
        order by audit_id desc
        limit 200
    </select>
</mapper>
